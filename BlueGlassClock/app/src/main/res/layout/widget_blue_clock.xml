<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#07182C">

    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/comic_wallpaper"
        android:scaleType="centerCrop"
        android:contentDescription="Blue comic wallpaper"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#55001630"/>

    <TextClock
        android:id="@+id/clock"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:format12Hour="h:mm"
        android:format24Hour="HH:mm"
        android:includeFontPadding="false"
        android:textColor="#BFE6FFFF"
        android:textSize="66sp"
        android:textStyle="bold"
        android:shadowColor="#AA168BFF"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="13"/>
</FrameLayout>
